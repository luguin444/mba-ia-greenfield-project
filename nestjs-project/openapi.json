      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {}
      },
      "PartUrlDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1,
            "minimum": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned `UploadPart` URL. PUT the part bytes to it.",
            "example": "http://minio.localhost:9000/videos/0b6f…/source?partNumber=1&uploadId=…&X-Amz-Signature=…"
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "publicId": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "uploadId": {
            "type": "string",
            "description": "S3 multipart `UploadId`."
          },
          "partSize": {
            "type": "number",
            "description": "Size of every part except the last one, in bytes.",
            "example": 67108864
          },
          "partCount": {
            "type": "number",
            "example": 160
          },
          "parts": {
            "description": "First batch of part URLs (at most 100, ascending).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry of the part URLs in this response."
          }
        },
        "required": [
          "videoId",
          "publicId",
          "uploadId",
          "partSize",
          "partCount",
          "parts",
          "expiresAt"
        ]
      },
      "PartUrlsDto": {
        "type": "object",
        "properties": {}
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1,
            "minimum": 1
          },
          "size": {
            "type": "number",
            "description": "Stored part size in bytes.",
            "example": 5242880
          },
          "etag": {
            "type": "string",
            "example": "\"5d41402abc4b2a76b9719d911017c592\""
          }
        },
        "required": [
          "partNumber",
          "size",
          "etag"
        ]
      },
      "PartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadId": {
            "type": "string",
            "description": "S3 multipart `UploadId`."
          },
          "partSize": {
            "type": "number",
            "example": 67108864
          },
          "partCount": {
            "type": "number",
            "example": 160
          },
          "uploadedParts": {
            "description": "Every part already stored, ascending.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          },
          "parts": {
            "description": "Newly signed part URLs. Empty when nothing is missing and no `partNumbers` were given.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry of the part URLs in this response."
          }
        },
        "required": [
          "videoId",
          "uploadId",
          "partSize",
          "partCount",
          "uploadedParts",
          "parts",
          "expiresAt"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "publicId": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "title": {
            "type": "string",
            "example": "aula"
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ]
          },
          "publicationStatus": {
            "type": "string",
            "enum": [
              "draft"
            ]
          },
          "failureReason": {
            "type": "string",
            "enum": [
              "UPLOAD_ABANDONED",
              "UPLOAD_ABORTED",
              "UPLOAD_SIZE_MISMATCH",
              "INVALID_MEDIA",
              "PROCESSING_ERROR"
            ],
            "nullable": true
          },
          "fileName": {
            "type": "string",
            "example": "aula.mp4"
          },
          "mimeType": {
            "type": "string",
            "example": "video/mp4"
          },
          "sizeBytes": {
            "type": "number",
            "example": 10737418240
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true,
            "example": 12.5
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "videoCodec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audioCodec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "formatName": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "Public, unsigned URL of the thumbnail"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "processedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "publicId",
          "title",
          "processingStatus",
          "publicationStatus",
          "failureReason",
          "fileName",
          "mimeType",
          "sizeBytes",
          "durationSeconds",
          "width",
          "height",
          "videoCodec",
          "audioCodec",
          "formatName",
          "thumbnailUrl",
          "createdAt",
          "updatedAt",
          "processedAt"
        ]
      },
      "SignedUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned GET straight to storage. Supports HTTP Range (206), so a `<video>` can stream it.",
            "example": "http://minio.localhost:9000/videos/0b6f…/source?X-Amz-Expires=14400&X-Amz-Signature=…"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry of `url`. Ask for a new one after it."
          }
        },
        "required": [
          "url",
          "expiresAt"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}